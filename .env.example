# Copy this file to .env.local and fill in the values.
# The site runs in "preview mode" (forms succeed, nothing is saved) until
# the Supabase values are set.

# --- Supabase (Project Settings -> API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose this key in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional direct calendar links (Cal.com, Calendly, ...) ---
NEXT_PUBLIC_CAL_ASSESSMENT_URL=
NEXT_PUBLIC_CAL_ONE_ON_ONE_URL=
NEXT_PUBLIC_CAL_GROUP_URL=
NEXT_PUBLIC_CAL_HOMEWORK_URL=

# --- Optional email notifications (resend.com) ---
RESEND_API_KEY=
# Must be an address on a domain you verified in Resend.
# Leave empty to use Resend's test sender (delivers to your own inbox only).
RESEND_FROM_EMAIL=

# --- Teacher account: the email that may open /admin ---
ADMIN_EMAIL=
